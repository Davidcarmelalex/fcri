[Unit]
Description=FCRI Next.js web application
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/apps/fcri
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3001
ExecStart=/usr/bin/node /var/www/apps/fcri/.next/standalone/server.js
Restart=always
RestartSec=5
StandardOutput=append:/var/log/fcri/web.log
StandardError=append:/var/log/fcri/web-error.log

[Install]
WantedBy=multi-user.target
