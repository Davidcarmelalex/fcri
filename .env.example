# FCRI environment
NODE_ENV=development

# SMTP for inquiry notifications and acknowledgment mail
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=example-user
SMTP_PASS=example-password

# FCRI routing
FCRI_MAIL_FROM=FCRI <noreply@fcri.science>
FCRI_INBOX_EMAIL=ops@fcri.science

# Public treasury references shown on the support/token surfaces
NEXT_PUBLIC_FCRI_USDT_EVM=0x-usdt-evm-wallet-address
NEXT_PUBLIC_FCRI_USDC_EVM=0x-usdc-evm-wallet-address
