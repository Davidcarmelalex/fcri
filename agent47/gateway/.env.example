# Set a random secret (at least 32 characters) in a private server environment.
AGENT47_GATEWAY_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# HTTPS frontend origin, no wildcard. Blank disables cross-origin browser requests.
AGENT47_ALLOWED_ORIGINS=
# Optional local OSIRIS service; disabled by default.
AGENT47_OSIRIS_URL=
